# Public URL where Marksage is deployed — used for link previews (og:image, og:url).
# Copy to .env (or set it in your hosting provider) before `npm run build`. Not needed on Vercel: the project's
# production domain is used when this is unset (live: https://marksage.vercel.app).
VITE_SITE_URL=https://your-domain.example
